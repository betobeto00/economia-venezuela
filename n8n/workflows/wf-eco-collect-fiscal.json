          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 5 * * *"
            }
          ]
        }
      },
      "id": "5a000006-0000-4000-8000-000000000001",
      "name": "Diario 05:30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -100,
        0
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 4 * * 0"
            }
          ]
        }
      },
      "id": "5a000006-0000-4000-8000-000000000006",
      "name": "Dominical 04:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -100,
        200
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8090/run/backfill_fiscal_ocr",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"limit\": 20\n}\n",
        "options": {
          "timeout": 1800000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "5a000006-0000-4000-8000-000000000005",
      "name": "Backfill OCR histórico",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        120,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 300000,
      "credentials": {
        "httpHeaderAuth": {
          "id": "eco-runner-token",
          "name": "Economía VE - Runner token"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8090/run/collect_fiscal",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"days\": 2,\n  \"limit\": 5\n}\n",
        "options": {
          "timeout": 1800000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "5a000006-0000-4000-8000-000000000002",
      "name": "Gacetas + OCR",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        340,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 300000,
      "onError": "continueErrorOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "eco-runner-token",
          "name": "Economía VE - Runner token"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "5a000006-0000-4000-8000-0000000000a1",
              "leftValue": "={{ $json.http_status }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "5a000006-0000-4000-8000-000000000003",
      "name": "¿Ejecutado?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        560,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "5a000006-0000-4000-8000-0000000000b1",
              "name": "resumen",
              "value": "={{ $json.body.stdout }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "5a000006-0000-4000-8000-000000000004",
      "name": "Resumen OCR",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        800,
        0
      ]
    }
