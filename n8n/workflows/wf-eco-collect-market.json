{
  "name": "Economía VE - Recolectar mercado",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 30
            }
          ]
        }
      },
      "id": "1a000001-0000-4000-8000-000000000001",
      "name": "Cada 30 min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        -80,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8090/run/collect_market",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={}",
        "options": {
          "timeout": 900000
        },
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "1a000001-0000-4000-8000-000000000002",
      "name": "Runner: collect_market",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        200,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 60000,
      "onError": "stopWorkflow",
      "credentials": {
        "httpHeaderAuth": {
          "id": "eco-runner-token",
          "name": "Economía VE - Runner token"
        }
      }
    }
  ],
  "connections": {
    "Cada 30 min": {
      "main": [
        [
          {
            "node": "Runner: collect_market",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/Caracas"
  },
  "active": true,
  "pinData": {},
  "tags": []
}
