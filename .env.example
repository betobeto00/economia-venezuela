# ===========================================
# ECONOMÍA VENEZUELA - Variables de Entorno
# ===========================================

# Application
APP_NAME="Economía Venezuela"
APP_VERSION="0.1.0"
ENVIRONMENT=development
DEBUG=true
# Zona horaria de informes/dashboard (la DB guarda UTC)
TIMEZONE=America/Caracas

# Database (PostgreSQL + TimescaleDB)
DATABASE_URL=postgresql://postgres:password@localhost:5432/economia_ve

# Redis Cache
REDIS_URL=redis://localhost:6379

# BCV API (Banco Central de Venezuela)
BCV_API_KEY=

# Binance API
BINANCE_API_KEY=
BINANCE_API_SECRET=

# DeepSeek API (for AI analysis)
# Fallback de último recurso si no hay LLM1_*..LLM8_* configurados.
DEEPSEEK_API_KEY=

# Cadena de LLMs con fallback (mismo patrón que dev/ds)
# Se prueban en SECUENCIA: el primero que responda se usa.
# LLM1 = OpenRouter (modelo :free no necesita créditos)
LLM1_API_KEY=
LLM1_BASE_URL=https://openrouter.ai/api/v1
LLM1_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# LLM2 = endpoint local (Ollama). Si no se usa, borrar estas 3 líneas.
# Antes apuntaba a Railway (omniroute-production-*.up.railway.app).
LLM2_API_KEY=
LLM2_BASE_URL=http://localhost:11434/v1
LLM2_MODEL=llama3.1

# LLM3 = Z.AI (requiere cuenta con inferencia habilitada)
LLM3_API_KEY=
LLM3_BASE_URL=https://api.z.ai/api/v1
LLM3_MODEL=glm-5-turbo

# LLM4 = Gemini 2.5 Flash (gratis, con visión)
LLM4_API_KEY=
LLM4_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM4_MODEL=gemini-2.5-flash

# News API
NEWS_API_KEY=

# Google (Encuestas - Fase B)
# Ruta al JSON de la service account de Google (creada en Google Cloud Console)
# Necesita permisos: Google Sheets API + compartir las hojas de respuestas con el correo de la SA
GOOGLE_CREDENTIALS_PATH=
# Frecuencia de ingesta de respuestas (minutos)
SURVEY_COLLECT_INTERVAL_MINUTES=60
# Umbral de calidad mínima (0-1) para considerar válida una respuesta
SURVEY_QUALITY_THRESHOLD=0.5
# Mínimo de respuestas para publicar un punto de serie o una tarjeta
SURVEY_MIN_RESPONSES=5
# IDs de formularios y hojas vinculadas por segmento (ID de la URL de Google Forms/Sheets)
SURVEY_PERSONA_COMUN_FORM_ID=
SURVEY_PERSONA_COMUN_SHEET_ID=
SURVEY_COMERCIANTE_FORM_ID=
SURVEY_COMERCIANTE_SHEET_ID=

# Reddit API
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="EconomiaVenezuela/0.1.0"

# Twitter API
TWITTER_BEARER_TOKEN=

# Scheduling (in minutes/hours)
MARKET_COLLECT_INTERVAL_MINUTES=30
DOLLAR_COLLECT_INTERVAL_MINUTES=5
NEWS_COLLECT_INTERVAL_HOURS=6
SENTIMENT_ANALYSIS_HOUR=22
WEEKLY_REPORT_DAY=sunday
WEEKLY_REPORT_HOUR=8

# Dashboard
DASHBOARD_PORT=8501

# Runner HTTP (lo invoca n8n). RUNNER_TOKEN vacío = sin autenticación.
RUNNER_PORT=8090
RUNNER_TOKEN=

# Pesos de índices compuestos (JSON). Vacío = valores por defecto del código.
# IAE: exchange_rate, oil_production, sentiment, news_frequency, inflation
# IAE_WEIGHTS={"exchange_rate": 0.30, "oil_production": 0.25, "sentiment": 0.20, "news_frequency": 0.15, "inflation": 0.10}
# Riesgo soberano: spread, volatility, inflation, reserves, debt, oil,
# political, uncertainty, market_cap
# SOVEREIGN_RISK_WEIGHTS={"spread": 0.18, "volatility": 0.10, "inflation": 0.18, "reserves": 0.10, "debt": 0.10, "oil": 0.07, "political": 0.08, "uncertainty": 0.07, "market_cap": 0.12}

# Logging
LOG_LEVEL=INFO

# API Rate Limits
BCV_RATE_LIMIT=100
BINANCE_RATE_LIMIT=1200
NEWS_API_RATE_LIMIT=100

# MCP Tools (opencode)
# API key para el MCP Context7 (docs de librerías en tiempo real)
CONTEXT7_API_KEY=
